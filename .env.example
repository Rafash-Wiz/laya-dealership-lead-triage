# Optional: require Authorization: Bearer <key> for API requests.
# Set a strong value before exposing this API beyond localhost.
LAYA_API_KEY=

# Keep API bound to localhost by default. Change only behind an authenticated TLS proxy.
LAYA_BIND_ADDRESS=127.0.0.1
LAYA_HOST_PORT=8000

# Set to 1 to load the selected checkpoints before the server listens.
LAYA_PRELOAD=0
LAYA_MODELS=english,multilingual
LAYA_MODEL=auto
LAYA_DEVICE=cpu
OMP_NUM_THREADS=4
